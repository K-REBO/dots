{
  "$schema": "https://raw.githubusercontent.com/vicinaehq/vicinae/refs/heads/main/extra/schemas/extension.json",
  "name": "discord-clipboard",
  "title": "Discord Clipboard",
  "description": "Send clipboard text to a Discord channel via discord_cli",
  "icon": "extension-icon.png",
  "author": "bido",
  "license": "MIT",
  "categories": ["System"],
  "commands": [
    {
      "name": "send-clipboard-discord",
      "title": "Send Clipboard to Discord",
      "subtitle": "Discord Clipboard",
      "description": "クリップボードの内容をDiscordチャンネルへ即送信する",
      "mode": "no-view",
      "preferences": [
        {
          "name": "channel",
          "title": "Channel ID",
          "description": "送信先のDiscordチャンネルID",
          "type": "textfield",
          "required": false,
          "default": "1515796187389755575"
        }
      ]
    }
  ],
  "dependencies": {
    "@vicinae/api": "^0.21.6"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  },
  "scripts": {
    "build": "vici build",
    "dev": "vici develop"
  }
}
