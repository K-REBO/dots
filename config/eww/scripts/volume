#!/usr/bin/env bash
# Volume control script using wpctl (PipeWire)

get_volume() {
  wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null | awk '{print int($2 * 100)}'
}

is_muted() {
  wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null | grep -q MUTED
}

get_icon() {
  if is_muted; then
    echo "󰖁"
  else
    vol=$(get_volume)
    if [ "$vol" -ge 70 ]; then
      echo "󰕾"
    elif [ "$vol" -ge 30 ]; then
      echo "󰖀"
    elif [ "$vol" -gt 0 ]; then
      echo "󰕿"
    else
      echo "󰖁"
    fi
  fi
}

list_sinks() {
  local default_name
  default_name=$(wpctl inspect @DEFAULT_AUDIO_SINK@ 2>/dev/null \
    | grep -E 'node\.name' | sed 's/.*= "\(.*\)"/\1/' | head -1)

  local dump
  dump=$(pw-dump 2>/dev/null)

  echo "$dump" | jq -c --arg default "$default_name" '
    [.[] | select(.info.props["media.class"] == "Audio/Sink") | {
      id: .id,
      name: (.info.props["node.description"]
          // .info.props["node.nick"]
          // .info.props["node.name"]
          // "Unknown"),
      is_default: (.info.props["node.name"] == $default),
      muted: (.info.params.Props[0].mute // false)
    }]'
}

set_sink() {
  wpctl set-default "$1" 2>/dev/null
  eww update audio-sinks="$(list_sinks)"
}

mute_sink() {
  wpctl set-mute "$1" toggle 2>/dev/null
  eww update audio-sinks="$(list_sinks)"
}

update_eww() {
  eww update volume-percent="$(get_volume)" volume-icon="$(get_icon)"
}

listen() {
  update_eww
  while true; do
    sleep 0.5
    update_eww
  done
}

case "$1" in
  icon)     get_icon ;;
  percent)  get_volume ;;
  sinks)    list_sinks ;;
  set-sink)  set_sink "$2" ;;
  mute-sink) mute_sink "$2" ;;
  toggle)
    wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
    update_eww
    ;;
  up)
    wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
    update_eww
    ;;
  down)
    wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
    update_eww
    ;;
  set)
    vol="${2%.*}"
    wpctl set-volume @DEFAULT_AUDIO_SINK@ "${vol}%"
    update_eww
    ;;
  listen) listen ;;
  *)
    if [ "$1" = "up" ] || [ "$1" = "" ]; then
      wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
    else
      wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
    fi
    update_eww
    ;;
esac
