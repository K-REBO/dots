#!/usr/bin/env bash
STATE="$HOME/.local/share/hypridle/dpms-timeout"
CONFIG="$HOME/.config/hypr/hypridle.conf"
DEFAULT=300
LOCK_TIMEOUT=3000

get() { [ -f "$STATE" ] && cat "$STATE" || echo $DEFAULT; }

label() {
  local t=$(get)
  case "$t" in
    0)    echo "無効" ;;
    300)  echo "5分" ;;
    900)  echo "15分" ;;
    1800) echo "30分" ;;
    3600) echo "1時間" ;;
    *)    echo "$((t/60))分" ;;
  esac
}

set_dpms() {
  local t="$1"
  mkdir -p "$(dirname "$STATE")"
  echo "$t" > "$STATE"

  rm -f "$CONFIG"
  if [ "$t" = "0" ]; then
    cat > "$CONFIG" <<EOF
general {
    before_sleep_cmd = loginctl lock-session
    after_sleep_cmd = hyprctl dispatch dpms on
}
listener {
    timeout = $LOCK_TIMEOUT
    on-timeout = hyprlock
    on-resume = hyprctl dispatch dpms on
}
EOF
  else
    cat > "$CONFIG" <<EOF
general {
    before_sleep_cmd = loginctl lock-session
    after_sleep_cmd = hyprctl dispatch dpms on
}
listener {
    timeout = $LOCK_TIMEOUT
    on-timeout = hyprlock
    on-resume = hyprctl dispatch dpms on
}
listener {
    timeout = $t
    on-timeout = hyprctl dispatch dpms off
    on-resume = hyprctl dispatch dpms on
}
EOF
  fi

  pkill -x hypridle 2>/dev/null
  sleep 0.1
  hypridle &
  eww update dpms-label="$(label)"
}

case "$1" in
  label) label ;;
  set)   set_dpms "$2" ;;
  *)     label ;;
esac
