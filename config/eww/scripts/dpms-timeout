#!/usr/bin/env bash
STATE="$HOME/.local/share/hypridle/dpms-timeout"
CONFIG="$HOME/.config/hypr/hypridle.conf"
DEFAULT=300
# ロック後、バックライトを消すまでの追加の待ち時間
DPMS_AFTER_LOCK=300

get() { [ -f "$STATE" ] && cat "$STATE" || echo $DEFAULT; }

label() {
  local t=$(get)
  case "$t" in
    0)    echo "無効" ;;
    300)  echo "5分" ;;
    900)  echo "15分" ;;
    1800) echo "30分" ;;
    3600) echo "1時間" ;;
    *)    echo "$((t/60))分" ;;
  esac
}

set_dpms() {
  local t="$1"
  mkdir -p "$(dirname "$STATE")"
  echo "$t" > "$STATE"

  rm -f "$CONFIG"
  if [ "$t" = "0" ]; then
    # off: 自動ロック/画面オフを完全に無効化
    cat > "$CONFIG" <<EOF
general {
    before_sleep_cmd = loginctl lock-session
    after_sleep_cmd = hyprctl dispatch dpms on
}
EOF
  else
    # bar で選んだ時間 = ロックまでの時間。バックライトオフはその少し後に連動させる
    cat > "$CONFIG" <<EOF
general {
    before_sleep_cmd = loginctl lock-session
    after_sleep_cmd = hyprctl dispatch dpms on
}
listener {
    timeout = $t
    on-timeout = hyprlock
    on-resume = hyprctl dispatch dpms on
}
listener {
    timeout = $((t + DPMS_AFTER_LOCK))
    on-timeout = hyprctl dispatch dpms off
    on-resume = hyprctl dispatch dpms on
}
EOF
  fi

  pkill -x hypridle 2>/dev/null || true
  # hypridle の完全終了を待ってから再起動
  while pgrep -x hypridle > /dev/null 2>&1; do sleep 0.05; done
  hypridle &
}

case "$1" in
  label) label ;;
  set)   set_dpms "$2" ;;
  *)     label ;;
esac
